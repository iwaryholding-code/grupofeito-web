<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&q=80&w=2000" alt="Oficina corporativa" class="w-full h-full object-cover opacity-10" />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-cream via-brand-cream/95 to-brand-cream"></div>
  </div>
  
  <div class="container mx-auto px-6 relative z-10 max-w-4xl text-center">
    <span class="inline-block py-1 px-3 rounded-full bg-brand-gold/10 text-brand-gold text-xs font-semibold tracking-wider uppercase mb-6">Consultoría Fiscal Estratégica</span>
    <h1 class="text-5xl lg:text-6xl font-bold text-brand-navy mb-6 leading-tight">
      Optimización Fiscal con <span class="text-brand-gold">Respaldo Legal</span>
    </h1>
    <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto font-light">
      Asesoría especializada para personas físicas y morales. Maximizamos sus beneficios dentro del marco legal con un enfoque en fiscalidad internacional.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contacto" class="bg-brand-navy text-white px-8 py-4 rounded-sm font-medium hover:bg-brand-gold transition duration-300 shadow-lg">
        Diagnóstico Fiscal Gratuito
      </a>
      <a href="/servicios" class="border border-brand-navy text-brand-navy px-8 py-4 rounded-sm font-medium hover:bg-brand-navy hover:text-white transition duration-300">
        Explorar Servicios
      </a>
    </div>
  </div>
</section>
