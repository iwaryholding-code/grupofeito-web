---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto" description="Contacta a Grupo Feitco para una consulta fiscal">
  <Header />
  
  <section class="bg-gradient-to-br from-blue-900 to-blue-700 text-white py-32 mt-0">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-5xl font-bold mb-6">Contacto</h1>
      <p class="text-xl text-gray-200 max-w-3xl mx-auto">
        Agenda tu diagnóstico fiscal gratuito hoy mismo
      </p>
    </div>
  </section>
  
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-blue-900 mb-6">Información de Contacto</h2>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="text-2xl">📧</div>
              <div>
                <h3 class="font-bold text-blue-900">Email</h3>
                <p class="text-gray-600">contacto@grupofeitco.com</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="text-2xl">📞</div>
              <div>
                <h3 class="font-bold text-blue-900">Teléfono</h3>
                <p class="text-gray-600">+52 (XXX) XXX-XXXX</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="text-2xl">📍</div>
              <div>
                <h3 class="font-bold text-blue-900">Ubicación</h3>
                <p class="text-gray-600">Los Altos de Jalisco, México</p>
              </div>
            </div>
          </div>
          
          <div class="mt-8 bg-blue-50 p-6 rounded-lg">
            <h3 class="font-bold text-blue-900 mb-3">Horario de Atención</h3>
            <p class="text-gray-600">Lunes a Viernes: 9:00 AM - 6:00 PM</p>
            <p class="text-gray-600">Sábados: Con cita previa</p>
          </div>
        </div>
        
        <div>
          <h2 class="text-3xl font-bold text-blue-900 mb-6">Envíanos un Mensaje</h2>
          
          <form 
            name="contacto" 
            method="POST" 
            netlify 
            netlify-honeypot="bot-field"
            class="space-y-6"
            data-netlify="true"
          >
            <input type="hidden" name="form-name" value="contacto" />
            <input type="hidden" name="bot-field" />
            
            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="nombre">
                Nombre completo *
              </label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-900"
                placeholder="Tu nombre completo"
              />
            </div>
            
            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="email">
                Correo electrónico *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-900"
                placeholder="tu@email.com"
              />
            </div>
            
            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="telefono">
                Teléfono
              </label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-900"
                placeholder="(XXX) XXX-XXXX"
              />
            </div><div>
              <label class="block text-gray-700 font-semibold mb-2" for="servicio">
                Servicio de interés *
              </label>
              <select 
                id="servicio" 
                name="servicio" 
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-900"
              >
                <option value="">Selecciona un servicio</option>
                <option value="resico">Régimen Simplificado de Confianza (RESICO)</option>
                <option value="personas-fisicas">Personas Físicas - Declaración Anual</option>
                <option value="personas-morales">Personas Morales</option>
                <option value="maquila">Maquila y Manufactura</option>
                <option value="llc-eeuu">LLC en Estados Unidos</option>
                <option value="fiscal-internacional">Fiscal Internacional</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            
            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="mensaje">
                Mensaje *
              </label>
              <textarea 
                id="mensaje" 
                name="mensaje" 
                rows="4" 
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-900"
                placeholder="Cuéntanos sobre tu situación fiscal..."
              ></textarea>
            </div>
            
            <button 
              type="submit" 
              class="w-full bg-blue-900 text-white py-4 rounded-lg font-semibold hover:bg-blue-800 transition"
            >
              Enviar Mensaje
            </button>
            
            <p class="text-sm text-gray-500 text-center">
              * Campos obligatorios
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>

<script>
  document.querySelector('form[name="contacto"]').addEventListener('submit', async function(e) {
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    try {
      await fetch('https://n8n.iwaryholding.com/webhook/grupofeitco-contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
    } catch (error) {
      console.error('Error enviando a n8n:', error);
    }
  });
</script>
