---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nosotros" description="Conoce a Grupo Feitco - Consultoría Fiscal">
  <Header />
  
  <section class="bg-gradient-to-br from-blue-900 to-blue-700 text-white py-32 mt-0">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-5xl font-bold mb-6">Sobre Nosotros</h1>
      <p class="text-xl text-gray-200 max-w-3xl mx-auto">
        Más de una década brindando soluciones fiscales estratégicas
      </p>
    </div>
  </section>
  
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Nuestra Misión</h2>
      <p class="text-gray-600 text-lg mb-8">
        Brindar asesoría fiscal de excelencia que permita a nuestros clientes optimizar 
        su situación tributaria dentro del marco legal, con un enfoque personalizado y 
        utilizando las herramientas tecnológicas más avanzadas.
      </p>
      
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Nuestra Visión</h2>
      <p class="text-gray-600 text-lg mb-8">
        Ser reconocidos como la firma de consultoría fiscal líder en México, 
        especializada en fiscalidad internacional y estructuración de negocios, 
        distinguidos por nuestra ética profesional, conocimiento técnico y resultados comprobados.
      </p>
      
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Nuestros Valores</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-xl font-bold text-blue-900 mb-3">Integridad</h3>
          <p class="text-gray-600">Actuamos con total transparencia y ética profesional en cada asesoría.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-xl font-bold text-blue-900 mb-3">Excelencia</h3>
          <p class="text-gray-600">Buscamos la máxima calidad en cada servicio que brindamos.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-xl font-bold text-blue-900 mb-3">Compromiso</h3>
          <p class="text-gray-600">Nos involucramos en el éxito fiscal de nuestros clientes.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-xl font-bold text-blue-900 mb-3">Innovación</h3>
          <p class="text-gray-600">Utilizamos tecnología de punta para optimizar procesos y resultados.</p>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
