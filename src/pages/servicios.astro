---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Servicios" description="Servicios de consultoría fiscal premium">
  <Header />
  
  <section class="pt-32 pb-20 bg-brand-navy text-white">
    <div class="container mx-auto px-6 text-center max-w-3xl">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-gold/10 text-brand-gold text-xs font-semibold tracking-wider uppercase mb-6">Áreas de Práctica</span>
      <h1 class="text-5xl font-bold mb-6">Soluciones Fiscales Integrales</h1>
      <p class="text-xl text-gray-300 font-light">Estrategias adaptadas a la complejidad de su negocio.</p>
    </div>
  </section>

  <section class="py-20 bg-brand-cream">
    <div class="container mx-auto px-6 max-w-6xl">
      
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-brand-navy mb-8 flex items-center">
          <span class="w-12 h-1 bg-brand-gold mr-4"></span> Personas Físicas
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-gold shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">Régimen Simplificado (RESICO)</h3>
            <p class="text-gray-600 font-light">Alta, asesoría mensual, optimización de deducciones y cumplimiento estricto ante el SAT.</p>
          </div>
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-navy shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">Sueldos y Salarios</h3>
            <p class="text-gray-600 font-light">Declaración anual, devoluciones y estrategias para optimizar ingresos por compensaciones.</p>
          </div>
        </div>
      </div>

      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-brand-navy mb-8 flex items-center">
          <span class="w-12 h-1 bg-brand-gold mr-4"></span> Personas Morales
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-gold shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">Régimen General de Ley</h3>
            <p class="text-gray-600 font-light">Contabilidad electrónica, DICTAMEN fiscal, opiniones de cumplimiento y planeación tributaria.</p>
          </div>
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-navy shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">Maquila y Manufactura</h3>
            <p class="text-gray-600 font-light">Asesoría especializada en programa IMMEX, precios de transferencia y cumplimiento global.</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-3xl font-serif font-bold text-brand-navy mb-8 flex items-center">
          <span class="w-12 h-1 bg-brand-gold mr-4"></span> Fiscal Internacional
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-gold shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">LLCs en Estados Unidos</h3>
            <p class="text-gray-600 font-light">Constitución, obtención de EIN, Forms 5472/1120, FBAR y cumplimiento FATCA.</p>
          </div>
          <div class="bg-white p-8 rounded-sm border-l-4 border-brand-navy shadow-sm">
            <h3 class="text-xl font-bold text-brand-navy mb-3">Tratados Internacionales</h3>
            <p class="text-gray-600 font-light">Evitación de doble tributación, certificados de residencia fiscal y planeación transfronteriza.</p>
          </div>
        </div>
      </div>

    </div>
  </section>
  <Footer />
</Layout>
