---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Servicios" description="Servicios de consultoría fiscal de Grupo Feitco">
  <Header />
  
  <section class="bg-gradient-to-br from-blue-900 to-blue-700 text-white py-32 mt-0">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-5xl font-bold mb-6">Nuestros Servicios</h1>
      <p class="text-xl text-gray-200 max-w-3xl mx-auto">
        Soluciones fiscales integrales adaptadas a tus necesidades
      </p>
    </div>
  </section>
  
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 border-b-2 border-blue-900 pb-2">Personas Físicas</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">Régimen Simplificado de Confianza (RESICO)</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Alta y asesoría en el régimen</li>
              <li>Declaraciones mensuales y anuales</li>
              <li>Optimización de deducciones</li>
              <li>Cumplimiento ante el SAT</li>
            </ul>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">Sueldos y Salarios</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Declaración anual de personas físicas</li>
              <li>Devoluciones de impuestos</li>
              <li>Optimización de ingresos</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 border-b-2 border-blue-900 pb-2">Personas Morales</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">Régimen General de Ley</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Declaraciones mensuales y anuales</li>
              <li>Contabilidad electrónica</li>
              <li>DICTAMEN fiscal</li>
              <li>Opinión de cumplimiento</li>
            </ul>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">Maquilas y Manufactura</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Asesoría en régimen de maquila</li>
              <li>Precios de transferencia</li>
              <li>Programa IMMEX</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 border-b-2 border-blue-900 pb-2">Fiscal Internacional</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">LLCs en Estados Unidos</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Constitución de LLCs</li>
              <li>Obtención de EIN</li>
              <li>Declaraciones ante el IRS (Forms 5472, 1120)</li>
              <li>FBAR y FATCA</li>
            </ul>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold mb-3">Tratados Internacionales</h3>
            <ul class="list-disc list-inside text-gray-600 space-y-2">
              <li>Evitación de doble tributación</li>
              <li>Certificados de residencia fiscal</li>
              <li>Precios de transferencia internacionales</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
